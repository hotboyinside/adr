{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "jest"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react",
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["electron/**/*", "src/**/*", "renderer/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "sidecar"]
}
