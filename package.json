{
  "name": "transcribe-app",
  "version": "0.1.0",
  "description": "System audio capture and real-time transcription desktop app",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:main": "tsc --project tsconfig.json",
    "build:renderer": "webpack --config webpack.config.js",
    "build:native": "cmake-js build --directory=sidecar --out=sidecar/build",
    "build:ts": "tsc --noEmit",
    "build": "npm run build:main && npm run build:renderer",
    "build:all": "npm run build && npm run build:native",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "dev": "npm run build:all && electron .",
    "dev:consent": "npm run build && VERBATIM_RESET_CONSENT=1 electron .",
    "dev:permission-unknown": "npm run build && VERBATIM_RESET_CONSENT=1 VERBATIM_DEV_PERMISSION=not-determined electron .",
    "dev:permission-denied": "npm run build && VERBATIM_RESET_CONSENT=1 VERBATIM_DEV_PERMISSION=denied electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.1",
    "@types/ws": "^8.18.1",
    "cmake-js": "^8.0.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "node-addon-api": "^8.7.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.{ts,tsx}",
      "**/*.test.{ts,tsx}"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  },
  "dependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.20.0"
  }
}
